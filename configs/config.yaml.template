app:
  name: lib-common
  version: v1.0
  host: 127.0.0.1
  port: 8080
  tz: Asia/Shanghai
  secret_key: "YOUR_SECRET_KEY_HERE"  # 请替换为你的密钥，至少32位十六进制字符串
  algorithm: HS256
  access_token_expire: 10 # 分钟
  refresh_token_expire: 3 # 天

loggers:
  common:
    level: DEBUG
    format: "{time:YYYY-MM-DD HH:mm:ss:SSS} | {level: <8} | {process}:{thread} | {name}:{function}:{line} | {message}"
    colorize: false
    serialize: false
    backtrace: true
    enqueue: true
    diagnose: true
    rotation: "10 MB"
    retention: "1 weeks"
    compression: "zip"
    encoding: "utf-8"
    sensitive_fields: (password|token|key|secret|token|session|cookie|csrf|jwt|access_token|refresh_token|id_token|client_secret|client_id|api_key|secret)
    sensitive_fields_replacement: "********"
    max_length: 1000
    max_length_replacement: "..."
  console:
    type: "ConsoleLogger"
    level: "DEBUG"
  run:
    type: "AppLogger"
    level: "DEBUG"
  operate:
    level: "INFO"
  api:
    level: "INFO"

# 加解密器配置
cryptors:
  root:
    salt: "YOUR_ROOT_SALT_HERE"  # 请替换为你的根盐值，base64编码字符串

# 数据库配置
databases:
  app:
    type: AsyncSQLAlchemyDB
    infra:
      host: "YOUR_DB_HOST"
      port: 5432
      username: "YOUR_DB_USERNAME"
      password: "YOUR_DB_PASSWORD"  # 请替换为你的数据库密码
    dialect: postgresql
    driver: asyncpg
    database: "YOUR_DATABASE_NAME"
  local:
    type: SQLAlchemyDB
    infra:
      host: "YOUR_DB_HOST"
      port: 5432
      username: "YOUR_DB_USERNAME"
      password: "YOUR_DB_PASSWORD"  # 请替换为你的数据库密码
    dialect: postgresql
    driver: asyncpg
    database: "YOUR_DATABASE_NAME"

redis:
  primary:
    host: "localhost"
    port: 6379
    db: 0

# 配置说明：
# 1. 复制此文件为 config.yaml
# 2. 替换所有 "YOUR_*" 占位符为实际值
# 3. 确保 config.yaml 在 .gitignore 中，不提交到版本控制
# 4. 敏感信息建议使用环境变量或加密存储